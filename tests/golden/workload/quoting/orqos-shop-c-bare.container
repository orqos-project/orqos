# Managed by Orqos for owner 0123456789abcdef0123456789abcdef. Do not edit: the next apply replaces this file.
[Unit]
Description=Orqos workload pod shop container bare owner 0123456789abcdef0123456789abcdef
StartLimitIntervalSec=0

[Container]
ContainerName=orqos-shop-bare
Pod=orqos-shop.pod
Image=alpine:3.22
Exec="a b" "quote\"d" "$$X" "50%%"
Label=dev.orqos.owner=0123456789abcdef0123456789abcdef
