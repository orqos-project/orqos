# Managed by Orqos for owner 0123456789abcdef0123456789abcdef. Do not edit: the next apply replaces this file.
[Unit]
Description=Orqos workload pod shop container api owner 0123456789abcdef0123456789abcdef
StartLimitIntervalSec=0

[Container]
ContainerName=orqos-shop-api
Pod=orqos-shop.pod
Image=registry.example.com/api:1
EnvironmentFile=orqos-shop-c-api.env
User=1000
GroupAdd=2000
ReadOnly=true
Mount=type=bind,source=/var/lib/orqos/workload/files/shop/tls,destination=/etc/tls,ro,idmap
Mount=type=bind,source=/var/lib/orqos/workload/files/shop/settings/certs/ca.pem,destination=/etc/app/ca.pem,ro,idmap
Mount=type=bind,source=/var/lib/orqos/workload/files/shop/settings,destination=/etc/certs,ro,idmap
Label=dev.orqos.owner=0123456789abcdef0123456789abcdef
Label=dev.orqos.pod=shop
StopTimeout=30

[Service]
Restart=always
RestartSec=1s
RestartSteps=8
RestartMaxDelaySec=300s
TimeoutStartSec=600
TimeoutStopSec=60
