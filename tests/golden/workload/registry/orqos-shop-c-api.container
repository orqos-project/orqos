# Managed by Orqos for owner 0123456789abcdef0123456789abcdef. Do not edit: the next apply replaces this file.
[Unit]
Description=Orqos workload pod shop container api owner 0123456789abcdef0123456789abcdef
StartLimitIntervalSec=0

[Container]
ContainerName=orqos-shop-api
Pod=orqos-shop.pod
Image=localhost:5000/rezn/private:1
Pull=always
PodmanArgs=--authfile=/var/lib/orqos/workload/files/shop/registry-auth.json
Label=dev.orqos.owner=0123456789abcdef0123456789abcdef
