# Managed by Orqos for owner 0123456789abcdef0123456789abcdef. Do not edit: the next apply replaces this file.
[Unit]
Description=Orqos workload pod shop container trust owner 0123456789abcdef0123456789abcdef
StartLimitIntervalSec=0

[Container]
ContainerName=orqos-shop-trust
Pod=orqos-shop.pod
Image=alpine:3.22
Entrypoint=["/bin/sh","-c","echo 1 > /work/order"]
Mount=type=volume,source=orqos-shop-scratch-work,destination=/work,idmap
Label=dev.orqos.owner=0123456789abcdef0123456789abcdef
Label=dev.orqos.pod=shop
StopTimeout=30

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartMode=direct
TimeoutStartSec=infinity
RestartSec=1s
RestartSteps=8
RestartMaxDelaySec=300s
TimeoutStopSec=60
